{
  "model": "LightGBM",
  "family": "Boosting",
  "params": {
    "n_estimators": 400,
    "learning_rate": 0.05,
    "num_leaves": 63,
    "min_child_samples": 20,
    "subsample": 0.8,
    "subsample_freq": 1,
    "colsample_bytree": 0.8,
    "reg_lambda": 0.0
  },
  "max_train_rows": null,
  "notes": "leaf-wise gradient boosting",
  "seed": 42,
  "features": [
    "dist_m",
    "dist_rank",
    "dist_minus_min",
    "dist_ratio",
    "n_cands",
    "t_proj",
    "at_endpoint",
    "heading_diff",
    "heading_diff_undirected",
    "heading_valid",
    "ctx_mean_dist",
    "ctx_max_dist",
    "smooth_dist",
    "speed",
    "dt_prev",
    "gap_before",
    "gap_after",
    "arc_len",
    "has_reverse",
    "in_deg_u",
    "out_deg_v"
  ]
}