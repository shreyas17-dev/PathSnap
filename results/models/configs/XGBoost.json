{
  "model": "XGBoost",
  "family": "Boosting",
  "params": {
    "n_estimators": 400,
    "learning_rate": 0.1,
    "max_depth": 6,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "min_child_weight": 1.0,
    "reg_lambda": 1.0,
    "tree_method": "hist",
    "device": "cuda",
    "eval_metric": "logloss"
  },
  "max_train_rows": null,
  "notes": "gradient boosting, GPU (CUDA) hist trees",
  "seed": 42,
  "features": [
    "dist_m",
    "dist_rank",
    "dist_minus_min",
    "dist_ratio",
    "n_cands",
    "t_proj",
    "at_endpoint",
    "heading_diff",
    "heading_diff_undirected",
    "heading_valid",
    "ctx_mean_dist",
    "ctx_max_dist",
    "smooth_dist",
    "speed",
    "dt_prev",
    "gap_before",
    "gap_after",
    "arc_len",
    "has_reverse",
    "in_deg_u",
    "out_deg_v",
    "heading_diff_ff",
    "along_cos_w3",
    "along_speed_w3",
    "twin_hd_adv",
    "hd_rank_near"
  ]
}